# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# dev server logs + rotated/pre-restart variants (dev.log*, *.bak)
dev.log*
*.bak

# live SQLite database (untracked — runtime data with customer PII; a fresh
# checkout creates it via `bun run db:push` + `bun run db:seed` / db:setup)
/db/

# Skills directory
/skills/

# one-off dev/audit artifacts — local-only, never tracked
/examples/
/scripts-tmp/

# scripts/ one-off audit & image-surgery artifacts (local-only; only start-dev-daemon.py is tracked)
/scripts/audit-capture.sh
/scripts/audit-i18n-3d.mjs
/scripts/audit-vlm.mjs
/scripts/capture-products.sh
/scripts/cut-generated.py
/scripts/fix-dark-images.py
/scripts/overflow-check.mjs
/scripts/products-vlm.mjs
/scripts/recut.py
/scripts/targeted-checks.mjs
/scripts/vlm-audit.mjs

# internal dev artifacts (audit screenshots, tool outputs, pid files)
/screenshots/
/tool-results/
*.pid
.claude/settings.local.json
# visual-audit generated artifacts (screenshots, previews) — scripts + final PDF stay tracked
/visual-audit/*.html
/visual-audit/*.jpg
/visual-audit/shots-pc/
/visual-audit/shots-mobile/
/visual-audit/shots-pc-jpg/
/visual-audit/shots-mobile-jpg/
!/visual-audit/LUT-Visual-Atlas.pdf
# sandbox download folder: keep placeholder only, PDFs live in visual-audit/ in the repo
/download/*.pdf

# download folder: keep placeholder README only (prompt copy is untracked)
/download/*
!/download/README.md
agent-ctx/
