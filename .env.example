# Prisma / SQLite database connection
# Local sandbox uses an absolute path; for your machine use a relative one:
DATABASE_URL="file:./db/custom.db"

# Admin panel password (POST /api/admin/login) — set a strong value in production
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# HMAC-SHA256 secret signing the lut_admin session cookie (generate: openssl rand -hex 32)
ADMIN_SESSION_SECRET="replace-with-64-random-hex-chars"

# Canonical site URL used for metadata (src/app/layout.tsx); falls back to http://localhost:3000
# NEXT_PUBLIC_SITE_URL="https://example.com"

# Set to 1 to log every SQL query (src/lib/db.ts); default logs errors/warnings only
# PRISMA_QUERY_LOG=1

# X-Forwarded-For trust for the admin login rate limiter (rightmost hop):
# - Development (default): XFF trusted — the sandbox always sits behind Caddy.
# - Production: set 1 ONLY behind a trusted appending reverse proxy; leaving it
#   unset in production ignores XFF (clients share one bucket, safe default).
# Set 0 to force-ignore XFF in any environment (direct exposure, no proxy).
# TRUST_PROXY=1
